# Multi-stage hermetic build for HCC frontend applications
#
# Targets:
#   deploy   — Caddy-based runtime for deployable frontend images
#   artifact — Minimal ubi-micro for security-compliance images (default)
#
# Existing consumers omitting --target get the artifact stage (backward-compatible).
# To build a deployable Caddy-serving image, use: --target deploy
#
# Consumer .tekton PipelineRun params (npm):
#   - name: dockerfile
#     value: build-tools/Dockerfile.hermetic
#   - name: hermetic
#     value: "true"
#   - name: prefetch-input
#     value: '{"type": "npm", "path": "."}'
#
# DEPLOY TARGET PREREQUISITE:
# Building the deploy target requires pipeline support for forwarding --target
# to the Buildah task's build command. The current shared pipeline
# (docker-build-run-unit-tests.yaml) and its pinned Buildah task do not expose
# a target-forwarding parameter. Required before consumers can use --target deploy:
#   1. The Buildah task must accept and forward a --target build arg
#   2. The shared or inline Tekton pipeline must expose this as a PipelineRun param
#   3. Consumer .tekton PipelineRun sets that parameter to "deploy"
# Without these changes, the build defaults to the artifact stage (backward-compatible).
# This cross-repository prerequisite is tracked separately from this Dockerfile.

# ────────── NODE.JS VERSION CONFIGURATION ──────────
# NOTE:
# These build arguments allow you to specify a different Node.js version
# and corresponding UBI image tag for the builder stage.
#
# Examples:
#   Node 22 (default): --build-arg NODE_BUILD_VERSION=22 --build-arg NODE_IMAGE_TAG=9.7-1776041578
#   Node 24: --build-arg NODE_BUILD_VERSION=24 --build-arg NODE_IMAGE_TAG=<appropriate-tag>
#
# To find available tags, visit:
# https://catalog.redhat.com/software/containers/ubi9/nodejs-22/62e8e7ed22d1d3c2dfe2ca01
ARG NODE_BUILD_VERSION=22
ARG NODE_IMAGE_TAG=9.8-1793064801
FROM registry.access.redhat.com/ubi9/nodejs-${NODE_BUILD_VERSION}:${NODE_IMAGE_TAG} AS builder

# Additional arguments to be appended for `npm ci`, e.g. "--legacy-peer-deps"
ARG NPM_CI_ARGS=

# Whether this is an IOP (Satellite) build — set to 'true' for IoP deployments
ARG IOP=false
ENV IOP=${IOP}

# ────────── SENTRY BUILD ARGS ──────────
# NOTE:
# Sentry sourcemap uploads require network access and will NOT work during
# hermetic RUN steps (--network=none). Pass these args to embed Sentry config
# in the build output; upload sourcemaps via a separate post-build pipeline task.
ARG ENABLE_SENTRY=false
ARG SENTRY_AUTH_TOKEN
ARG SENTRY_RELEASE
ENV ENABLE_SENTRY=${ENABLE_SENTRY} \
    SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN} \
    SENTRY_RELEASE=${SENTRY_RELEASE}

# ────────── APP VERSION ──────────
# NOTE:
# This build argument allows application owners to set a custom version string
# for their application, providing flexibility in version management.
# Pass it during build: --build-arg APP_VERSION=1.2.3
# Defaults to "unknown" if not specified.
ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

# ────────── SOURCE GIT METADATA ──────────
# NOTE:
# In CI environments with detached HEAD checkouts (e.g. Konflux/Tekton),
# git cannot determine the branch or tag from the working directory alone.
# Pass these build args so build_app_info_hermetic.js can include them in
# app.info.json. Example: --build-arg SOURCE_GIT_BRANCH=main
ARG SOURCE_GIT_BRANCH=""
ARG SOURCE_GIT_TAG=""
ENV SOURCE_GIT_BRANCH=${SOURCE_GIT_BRANCH} \
    SOURCE_GIT_TAG=${SOURCE_GIT_TAG}

# ────────── BUILD CONFIGURATION ──────────
ARG APP_BUILD_DIR=dist
ARG PACKAGE_JSON_PATH=package.json
ENV APP_BUILD_DIR=${APP_BUILD_DIR} \
    PACKAGE_JSON_PATH=${PACKAGE_JSON_PATH}

# Copy package files first for better layer caching
COPY --chown=default package*.json ./

# Install dependencies from Cachi2 prefetch cache
# CYPRESS_INSTALL_BINARY=0 prevents Cypress binary download attempt in hermetic env
RUN CYPRESS_INSTALL_BINARY=0 npm ci --offline --no-audit --no-fund $NPM_CI_ARGS

# Copy source code
COPY --chown=default . .

# Trust the working directory for git operations (needed by metadata generation)
RUN git config --global --add safe.directory /opt/app-root/src

# Build the frontend application
RUN IOP=${IOP} npm run build

# Generate Caddyfile for deploy target using Node.js (no jq dependency)
# Equivalent to server_config_gen.sh generate_caddy_config()
# Skipped if consumer provides their own Caddyfile or if script not found
RUN if [ -f build-tools/caddyfile_gen_hermetic.js ]; then \
      node build-tools/caddyfile_gen_hermetic.js; \
    elif [ ! -f Caddyfile ]; then \
      echo "Note: No Caddyfile found. Deploy target requires a Caddyfile or updated build-tools submodule."; \
    fi

# Generate app.info.json and app.info.deps.json metadata
# Equivalent to build_app_info.sh + server_config_gen.sh generate_app_info()
# Skipped if consumer provides their own or if script not found
RUN if [ -f build-tools/build_app_info_hermetic.js ]; then \
      node build-tools/build_app_info_hermetic.js; \
    fi


# ────────── DEPLOY TARGET ──────────
# Caddy-based runtime for deployable frontend images.
# Select with: --target deploy
#
# Preserves the same serving behavior as the regular (non-hermetic) Dockerfile:
# Caddy on port 8000, metrics on port 9000, app route /apps/<appname>/*.
#
# Pin runtime content by digest; Renovate tracks updates to the latest tag.
FROM quay.io/redhat-services-prod/hcm-eng-prod-tenant/caddy-ubi:latest@sha256:e329ebe7a312870b6cb62e3613bb63aaaacc2a7f5fa17047b1dffafe70e5adf9 AS deploy

COPY LICENSE /licenses/

ENV CADDY_TLS_MODE http_port 8000
# Caddy must have a default value for the public path or it will not start
ENV ENV_PUBLIC_PATH "/default"

ARG APP_BUILD_DIR=dist
ARG PACKAGE_JSON_PATH=package.json

# Configurable Red Hat labels for container compliance (same as artifact stage)
# Override via --build-arg for your application:
#   --build-arg LABEL_COMPONENT=my-app-hermetic
#   --build-arg LABEL_DESCRIPTION="My App - Hermetic Build"
ARG LABEL_COMPONENT=frontend-app-hermetic
ARG LABEL_DESCRIPTION="HCC Frontend Application - Hermetic Build"
ARG LABEL_URL="https://github.com/RedHatInsights"
ARG LABEL_SUMMARY="HCC Frontend Application"
LABEL com.redhat.component="${LABEL_COMPONENT}" \
      description="${LABEL_DESCRIPTION}" \
      distribution-scope="public" \
      io.k8s.description="${LABEL_DESCRIPTION}" \
      name="${LABEL_COMPONENT}" \
      release="1" \
      url="${LABEL_URL}" \
      vendor="Red Hat, Inc." \
      version="1.0" \
      maintainer="Red Hat Console Team <console@redhat.com>" \
      summary="${LABEL_SUMMARY}"

COPY --from=builder /opt/app-root/src/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /opt/app-root/src/${APP_BUILD_DIR} dist
COPY ${PACKAGE_JSON_PATH} .


# ────────── ARTIFACT TARGET (DEFAULT) ──────────
# Minimal ubi-micro image for security-compliance scanning.
# This is the last stage, so it is selected by default when no --target is
# specified — preserving backward compatibility with existing consumers.
#
# Contains only built artifacts, package.json, package-lock.json, and LICENSE.
# No Caddy, no server, no Node.js runtime.
FROM registry.access.redhat.com/ubi9/ubi-micro:latest AS artifact

# Configurable Red Hat labels for container compliance
# Override via --build-arg for your application:
#   --build-arg LABEL_COMPONENT=my-app-hermetic
#   --build-arg LABEL_DESCRIPTION="My App - Hermetic Build"
ARG LABEL_COMPONENT=frontend-app-hermetic
ARG LABEL_DESCRIPTION="HCC Frontend Application - Hermetic Build"
ARG LABEL_URL="https://github.com/RedHatInsights"
ARG LABEL_SUMMARY="HCC Frontend Application"
LABEL com.redhat.component="${LABEL_COMPONENT}" \
      description="${LABEL_DESCRIPTION}" \
      distribution-scope="public" \
      io.k8s.description="${LABEL_DESCRIPTION}" \
      name="${LABEL_COMPONENT}" \
      release="1" \
      url="${LABEL_URL}" \
      vendor="Red Hat, Inc." \
      version="1.0" \
      maintainer="Red Hat Console Team <console@redhat.com>" \
      summary="${LABEL_SUMMARY}"

# Create licenses directory and copy licenses
COPY --from=builder /opt/app-root/src/LICENSE /licenses/

# Create srv directory and copy built files from builder stage
ARG APP_BUILD_DIR=dist
RUN mkdir -p /srv
COPY --from=builder /opt/app-root/src/${APP_BUILD_DIR} /srv/dist
COPY --from=builder /opt/app-root/src/package.json /srv/package.json
COPY --from=builder /opt/app-root/src/package-lock.json /srv/package-lock.json

# Set to non-root user
USER 1001
